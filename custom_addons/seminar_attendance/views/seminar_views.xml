<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="seminar_tree_view" model="ir.ui.view">
        <field name="name">seminar.seminar.tree</field>
        <field name="model">seminar.seminar</field>
        <field name="arch" type="xml">
            <list string="Seminarios">
                <field name="name"/>
                <field name="date"/>
                <field name="location"/>
            </list>
        </field>
    </record>

    <record id="seminar_form_view" model="ir.ui.view">
        <field name="name">seminar.seminar.form</field>
        <field name="model">seminar.seminar</field>
        <field name="arch" type="xml">
            <form string="Seminario">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="location"/>
                    </group>
                    <notebook>
                        <page string="Descripción">
                            <field name="description"/>
                        </page>
                        <page string="Inscripciones">
                            <field name="registration_ids">
                                <list editable="bottom">
                                    <field name="contact_id"/>
                                    <field name="registration_date"/>
                                    <field name="attended"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="seminar_action" model="ir.actions.act_window">
        <field name="name">Seminarios</field>
        <field name="res_model">seminar.seminar</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>